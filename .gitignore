node_modules/
dist/
.env
output/
output-*/
# state/
# state-*/
.auth/
# input/*.txt
*.log

# Ảnh chụp màn hình do các script khảo sát/test sinh ra — chỉ để soi bằng mắt lúc chạy,
# không phải tài sản của repo.
scripts/*.png

# File audio narration (thành phẩm nặng, không lưu trong git).
*.mp3

# Ảnh tham khảo tải về — nặng (~20MB/tập) và TẢI LẠI ĐƯỢC: mỗi README.md giữ đủ
# URL nguồn + giấy phép, nên chỉ commit manifest, không commit ảnh.
# Dùng ** vì ảnh nằm trong thư mục con theo case (refs/case-N/), không phải phẳng.
narration-scripts/*/refs/**/*.jpg
narration-scripts/*/refs/**/*.jpeg
narration-scripts/*/refs/**/*.png
narration-scripts/*/refs/**/*.webp
