# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Gemini (miễn phí, dùng để viết prompt cảnh cho Veo3 từ đoạn truyện + trích xuất nhân vật)
# Lấy key tại https://aistudio.google.com/apikey (dùng gmail trieudev99@gmail.com)
GEMINI_API_KEY=

# Đường dẫn tới file input
STORY_INPUT_PATH=./input/story.txt

PARALLEL_WORKERS=1 

# Thư mục output
OUTPUT_DIR=./output

# Số giây mỗi clip Veo3 (mặc định 7)
CLIP_SECONDS=7

# # tạo thử 3 video
# TEST_SCENE_LIMIT=1

# Đặt =1 để bật debug: log chi tiết từng bước (baseline count, số chip @mention...) +
# lưu screenshot/HTML dump vào output/debug/ mỗi khi generate lỗi/timeout.
DEBUG=1

// -- narration-scripts/vu-viec-tam-linh-khong-the-giai-thich/assets.json --case 1
